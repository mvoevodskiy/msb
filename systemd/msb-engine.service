[Unit]
Description=msb-engine: one request (closed list of actions)
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStartPre=-/bin/sh -c '[ -s /usr/local/sbin/msb-engine ] && [ ! -L /usr/local/sbin/msb-engine ] || { [ -s /usr/local/lib/msb-engine/msb-engine.good ] && cp -- /usr/local/lib/msb-engine/msb-engine.good /usr/local/sbin/msb-engine.restore && chmod 0755 /usr/local/sbin/msb-engine.restore && mv -f -- /usr/local/sbin/msb-engine.restore /usr/local/sbin/msb-engine && echo MSB_ENGINE_HELPER_RESTORED; }'
ExecStart=/usr/bin/python3 -IS /usr/local/lib/msb-engine/cli.py run
WorkingDirectory=/
UMask=0077
PrivateTmp=yes
ProtectProc=invisible
NoNewPrivileges=yes
LockPersonality=yes
TimeoutStartSec=10min
TimeoutStopSec=30s
MemoryMax=512M
MemorySwapMax=256M
Nice=5
