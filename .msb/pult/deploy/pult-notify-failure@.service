# /etc/systemd/system/pult-notify-failure@.service — тревога в Telegram, когда служба Пульта
# упала и systemd перестал её перезапускать (OnFailure= в pult-web и pult-collector). %i — имя службы.
[Unit]
Description=Пульт: тревога об отказе службы %i

[Service]
Type=oneshot
User=client
Group=client
EnvironmentFile=/home/client/pult-secrets/web.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /home/client/pult-deploy/src/cli/notify-failure.ts %i
