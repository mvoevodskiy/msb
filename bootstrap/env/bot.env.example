# Per-bot env → /home/client/.msb/bots/<id>/.env
# Только отличающиеся ключи. Общие секреты — в /home/client/.msb/.env
# (systemd грузит этот файл; копия общего ключа сюда навсегда его перебьёт).

BOT_TOKEN=
MSB_BOT_ID=default
MSB_SESSION_DIR=/home/client/.msb/bots/default/sessions
MSB_TRANSCRIPT_DIR=/home/client/.msb/bots/default/transcripts
MSB_HOOKS_DIR=/home/client/.msb/bots/default/agent-hooks
MSB_TRACES_DIR=/home/client/.msb/bots/default/traces
MSB_CC_ONLY=1
