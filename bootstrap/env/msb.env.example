# Общий .env оркестратора → /home/client/.msb/.env (mode 600, owner client).
# Только ядро. Продуктовые ключи (PULT_*, SOCPUB_*, ZAPCITA_*, …) сюда не класть.

# Telegram: запасной/legacy; реальные токены — в bots/<id>/.env
BOT_TOKEN=

MSB_WORKSPACE_DIR=/home/client/workspace
MSB_SESSION_DIR=/home/client/.msb/bots/default/sessions
NODE_ENV=production

# Бэкенд MSB (puller/sync)
SYNC_URL=
SYNC_KEY=

# Владелец бота (Telegram user id)
ADMIN_ID=

# Claude Code (setup-token / OAuth)
CLAUDE_CODE_OAUTH_TOKEN=

# Платформенные тулзы агента
PROXYAPI_KEY=
DEEPGRAM_API_KEY=
AUTONOMY_DAILY_CAP_TOKENS=2000000

# Опционально
GITFLIC_TOKEN=
APIFY_API_KEY=
SUPADATA_API_KEY=
